.weui-cell {
  padding: 15px;
}

.weui-label {
  width: 60px;
}

.nickname_value {
  overflow: hidden;
  color: #666;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname_lock {
  flex: none;
  margin-left: 12px;
  color: #999;
  font-size: 12px;
}

.user_head {
  text-align: center;
  margin: 30px;
}

.avatar_button {
  width: 102px;
  height: 102px;
  padding: 0;
  margin: 0 auto 8px;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

.avatar_button::after {
  border: none;
}

.avatar_hint {
  margin-bottom: 8px;
  color: #888;
  font-size: 13px;
}

.user_head image {
  width: 100px;
  height: 100px;
  border-radius: 100%;
  border: 1px solid #ddd;
}
