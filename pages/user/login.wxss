/* 登录页：暖白底色、风筝主视觉、克制的童趣元素 */
page {
  background: #fffbf6;
}

.login-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 64rpx 48rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fffbf6;
}

/* ---------- 背景装饰 ---------- */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bg-blob-peach {
  top: -220rpx;
  right: -220rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(255, 214, 196, 0.9) 0%, rgba(255, 214, 196, 0) 70%);
}

.bg-blob-mint {
  bottom: -200rpx;
  left: -180rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(205, 235, 221, 0.9) 0%, rgba(205, 235, 221, 0) 70%);
}

.bg-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  opacity: 0.8;
}

.dot-a {
  top: 18%;
  left: 12%;
  background: #ffd166;
}

.dot-b {
  top: 36%;
  right: 10%;
  width: 8rpx;
  height: 8rpx;
  background: #9ed9c6;
}

.dot-c {
  bottom: 20%;
  right: 18%;
  width: 12rpx;
  height: 12rpx;
  background: #ffb3a7;
}

/* ---------- 内容区 ---------- */
.login-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 620rpx;
  text-align: center;
  animation: fade-up 0.55s ease both;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9c7b68;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.brand-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #ff8a65;
}

/* ---------- 风筝主视觉 ---------- */
.kite-scene {
  position: relative;
  width: 100%;
  height: 310rpx;
  margin-top: 34rpx;
}

.kite {
  position: absolute;
  z-index: 2;
  top: 20rpx;
  left: 50%;
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb08e 0%, #ff7a59 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 122, 89, 0.24);
  transform: translateX(-50%) rotate(45deg);
  animation: kite-float 5s ease-in-out infinite;
}

.kite-face {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform: rotate(-45deg);
}

.kite-eye {
  position: absolute;
  top: 58rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #6b3e2e;
}

.kite-eye-left {
  left: 48rpx;
}

.kite-eye-right {
  right: 48rpx;
}

.kite-smile {
  position: absolute;
  top: 76rpx;
  left: 50%;
  width: 26rpx;
  height: 14rpx;
  margin-left: -13rpx;
  border-bottom: 3rpx solid #6b3e2e;
  border-radius: 0 0 22rpx 22rpx;
}

.kite-tail {
  position: absolute;
  z-index: 1;
  top: 204rpx;
  left: calc(50% + 2rpx);
  width: 0;
  height: 96rpx;
  border-left: 3rpx dashed #e3c4b2;
  transform: rotate(10deg);
  transform-origin: top center;
}

.tail-bow {
  position: absolute;
  left: -9rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  transform: rotate(45deg);
}

.bow-one {
  top: 16rpx;
  background: #ffd166;
}

.bow-two {
  top: 46rpx;
  background: #ff9e7a;
}

.bow-three {
  top: 76rpx;
  background: #9ed9c6;
}

/* 两朵低饱和的小云，托住风筝 */
.cloud {
  position: absolute;
  z-index: 0;
  width: 120rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(180, 160, 145, 0.1);
}

.cloud::before,
.cloud::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
}

.cloud::before {
  top: -26rpx;
  left: 18rpx;
  width: 54rpx;
  height: 54rpx;
}

.cloud::after {
  top: -18rpx;
  right: 16rpx;
  width: 38rpx;
  height: 38rpx;
}

.cloud-left {
  top: 214rpx;
  left: 4rpx;
  transform: scale(0.9);
}

.cloud-right {
  top: 150rpx;
  right: 2rpx;
  opacity: 0.92;
  transform: scale(0.72);
}

/* ---------- 标题文案 ---------- */
.login-title {
  margin-top: 6rpx;
  color: #33404a;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.login-sub {
  margin-top: 14rpx;
  color: #8c9aa5;
  font-size: 21rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.8;
}

/* ---------- 登录按钮 ---------- */
.button-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 46rpx;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 520rpx;
  height: 96rpx;
  margin: 0 auto;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.login-button::after {
  border: none;
}

.login-button.is-locked {
  background: #f3dfd7;
  color: #b08c7d;
  box-shadow: none;
}

.login-button.is-ready {
  background: linear-gradient(135deg, #ff9e7a 0%, #ff7a59 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(255, 122, 89, 0.26);
}

.login-button[disabled] {
  background: #ffb39a;
  color: #ffffff;
  opacity: 0.75;
}

/* ---------- 提示 ---------- */
.login-hint {
  margin-top: 16rpx;
  color: #b3a49c;
  font-size: 20rpx;
  line-height: 1.6;
}

.privacy-hint {
  margin-top: 14rpx;
  color: #a08a7d;
  font-size: 20rpx;
  line-height: 1.6;
}

.privacy-link {
  margin-left: 8rpx;
  color: #e76f51;
  text-decoration: underline;
}

/* ---------- 协议勾选 ---------- */
.consent-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  margin-top: 38rpx;
}

.consent-check {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  margin-right: 12rpx;
  border: 2rpx solid #d9c9bf;
  border-radius: 10rpx;
  background: #ffffff;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.consent-check.checked {
  border-color: #ff8a65;
  background: #ff8a65;
}

.consent-check.is-alerting {
  border-color: #e76f51;
  background: #fff0ec;
}

.check-alert {
  color: #e76f51;
  font-weight: 700;
}

.consent-copy {
  max-width: 520rpx;
  color: #8c9aa5;
  font-size: 20rpx;
  line-height: 1.7;
  text-align: left;
}

.consent-link {
  color: #e76f51;
}

.consent-link.read {
  color: #aab6be;
}

.consent-error {
  margin-top: 12rpx;
  color: #e76f51;
  font-size: 19rpx;
}

.page-foot {
  margin-top: 40rpx;
  color: #b8aaa2;
  font-size: 18rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.6;
}

/* ---------- 动画 ---------- */
.is-shaking {
  animation: consent-shake 0.36s ease;
}

@keyframes consent-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-6rpx);
  }
  40% {
    transform: translateX(6rpx);
  }
  60% {
    transform: translateX(-4rpx);
  }
  80% {
    transform: translateX(4rpx);
  }
}

@keyframes kite-float {
  0%,
  100% {
    transform: translateX(-50%) translateY(0) rotate(45deg);
  }
  50% {
    transform: translateX(-50%) translateY(-12rpx) rotate(45deg);
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
