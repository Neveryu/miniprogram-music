.app_desc {
  padding: 0 40px 30px;
  color: #888;
  text-align: center;
}

.login-card {
  margin: 0 24px;
  padding: 40px 24px;
  border-radius: 16px;
  background-color: rgba(127, 127, 127, 0.08);
  text-align: center;
}

.wechat-login-icon {
  color: #07c160;
  font-size: 56px;
  line-height: 1;
}

.wechat-login-icon .iconfont {
  font-size: 56px;
}

.login-title {
  margin-top: 20px;
  font-size: 20px;
  font-weight: 600;
}

.login-desc {
  margin-top: 10px;
  color: #888;
  font-size: 14px;
}

.wechat-login-button {
  margin-top: 32px;
}
