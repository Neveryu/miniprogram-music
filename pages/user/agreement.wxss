page {
  background: #0b1020;
}

.agreement-page {
  min-height: 100vh;
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #0b1020;
  color: #f4ecdc;
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.agreement-head {
  padding: 52rpx 0 44rpx;
}

.head-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 179, 92, 0.45);
  border-radius: 8rpx;
  font-family: 'Courier New', monospace;
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: #ffb35c;
}

.head-title {
  margin-top: 26rpx;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 56rpx;
  font-weight: 500;
  line-height: 1.2;
  color: #f4ecdc;
}

.head-meta {
  display: flex;
  margin-top: 22rpx;
  align-items: center;
}

.meta-line {
  flex: 1;
  height: 1rpx;
  background: rgba(244, 236, 220, 0.14);
}

.head-meta text {
  margin: 0 22rpx;
  font-family: 'Courier New', monospace;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(244, 236, 220, 0.45);
}

.head-intro {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(244, 236, 220, 0.58);
}

/* ---------- 正文 ---------- */
.section {
  margin-top: 44rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid rgba(244, 236, 220, 0.08);
  border-radius: 20rpx;
  background: rgba(16, 23, 54, 0.5);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #ffcf8f;
}

.title-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 16rpx;
  border-radius: 2rpx;
  background: linear-gradient(135deg, #ffcf8f, #ff8a3d);
  transform: rotate(45deg);
}

.section-items {
  margin-top: 20rpx;
}

.section-item {
  position: relative;
  margin-top: 14rpx;
  padding-left: 22rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: rgba(244, 236, 220, 0.72);
}

.section-item::before {
  position: absolute;
  top: 20rpx;
  left: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 179, 92, 0.4);
  content: '';
}

/* ---------- 底部 ---------- */
.agreement-foot {
  margin-top: 52rpx;
}

.foot-line {
  height: 1rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(90deg, rgba(244, 236, 220, 0.18), rgba(244, 236, 220, 0));
}

.foot-text {
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
  color: rgba(244, 236, 220, 0.4);
}

.foot-back {
  display: flex;
  width: 100%;
  height: 96rpx;
  margin-top: 32rpx;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ffcf8f 0%, #ff9d4d 55%, #ff8a3d 100%);
  color: #241303;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.foot-back::after {
  border: none;
}

.foot-back:active {
  transform: scale(0.985);
}

/* ---------- 进场 ---------- */
.reveal {
  opacity: 0;
  animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.3, 1) forwards;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
