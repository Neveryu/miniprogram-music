<view class="login-page">
  <!-- 背景：柔和的暖色块与彩色圆点 -->
  <view class="bg-blob bg-blob-peach"></view>
  <view class="bg-blob bg-blob-mint"></view>
  <view class="bg-dot dot-a"></view>
  <view class="bg-dot dot-b"></view>
  <view class="bg-dot dot-c"></view>

  <view class="login-content">
    <!-- 品牌标记 -->
    <view class="brand-mark">
      <text class="brand-dot"></text>
      <text>Music For U</text>
    </view>

    <!-- 风筝：轻盈、童趣，呼应“快乐出发” -->
    <view class="kite-scene">
      <view class="cloud cloud-left"></view>
      <view class="cloud cloud-right"></view>
      <view class="kite">
        <view class="kite-face">
          <view class="kite-eye kite-eye-left"></view>
          <view class="kite-eye kite-eye-right"></view>
          <view class="kite-smile"></view>
        </view>
      </view>
      <view class="kite-tail">
        <view class="tail-bow bow-one"></view>
        <view class="tail-bow bow-two"></view>
        <view class="tail-bow bow-three"></view>
      </view>
    </view>

    <view class="login-title">准备好快乐出发了吗？</view>
    <view class="login-sub">随时随地、和孩子一起、快乐出发、有你也有TA~</view>

    <view class="button-wrap">
      <button
        wx:if="{{!agreementChecked}}"
        class="login-button is-locked"
        hover-class="none"
        bindtap="onLoginButtonTap"
      >
        <text>一键登录</text>
      </button>
      <button
        wx:else
        class="login-button is-ready"
        hover-class="none"
        open-type="chooseAvatar"
        bindchooseavatar="chooseWechatAvatar"
        loading="{{isLoggingIn}}"
        disabled="{{isLoggingIn}}"
      >
        <text>{{isLoggingIn ? '正在进入...' : '一键登录'}}</text>
      </button>
    </view>

    <view class="login-hint" wx:if="{{!agreementChecked}}">先勾选下面的小方框，就能进去啦</view>
    <view class="privacy-hint" wx:if="{{agreementChecked && !privacyReady}}">
      首次登录会弹出微信{{privacyContractName}}，同意后继续选择头像
      <text class="privacy-link" bindtap="openPrivacyContract">查看</text>
    </view>

    <view class="consent-row {{consentShake ? 'is-shaking' : ''}}">
      <view class="consent-check {{agreementChecked ? 'checked' : ''}} {{consentShake ? 'is-alerting' : ''}}" bindtap="toggleAgreement">
        <text wx:if="{{agreementChecked}}">✓</text>
        <text wx:elif="{{consentShake}}" class="check-alert">!</text>
      </view>
      <view class="consent-copy" bindtap="toggleAgreement">
        <text>我已阅读并同意</text>
        <text class="consent-link {{serviceRead ? 'read' : ''}}" catchtap="readAgreement" data-type="service">《用户服务协议》</text>
        <text>和</text>
        <text class="consent-link {{privacyRead ? 'read' : ''}}" catchtap="readAgreement" data-type="privacy">《隐私政策》</text>
      </view>
    </view>
    <view class="consent-error" wx:if="{{consentShake}}">先勾选同意，才能进去哦</view>

    <view class="page-foot">头像只会在房间里显示 · 登录由你本人确认</view>
  </view>
</view>
