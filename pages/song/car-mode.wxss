/* ============================================================
   Polar Night Line · 极夜航线
   色彩逻辑：环境冷（极地青夜 + 极光绿/青/紫）/ 灯光暖（琥珀路灯、珊瑚橘小车）
   注意：本页为 component 页面，样式隔离，page 选择器不生效
   ============================================================ */

.car-mode {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, #020a12 0%, #051627 30%, #082338 56%, #0d3049 78%, #071a2b 100%);
  z-index: 30;
  overflow: hidden;
  font-family: "PingFang SC", "HarmonyOS Sans", -apple-system, sans-serif;
}

/* ---------- 场景容器 ---------- */
.car-scene {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

/* 夜空氛围光：极光绿沉在地平线，青/紫浮在高空 */
.nav-nebula {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(56% 34% at 20% 12%, rgba(56, 212, 255, 0.08), transparent 70%),
    radial-gradient(46% 28% at 82% 8%, rgba(157, 123, 255, 0.07), transparent 70%),
    radial-gradient(64% 26% at 50% 44%, rgba(70, 242, 180, 0.09), transparent 72%);
}

/* ---------- 极光帷幕 ----------
   三条倾斜光带，缓慢横向漂移 + 呼吸；边缘本身柔和，
   不支持 filter 的环境退化为静态柔光带，不影响核心体验 */
.aurora {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 52%;
  overflow: hidden;
}
.aurora-band {
  position: absolute;
  left: -22%;
  right: -22%;
  height: 240rpx;
  filter: blur(26rpx);
  transform: skewY(-7deg);
}
.band-a {
  top: 6%;
  background: linear-gradient(180deg, transparent 0%, rgba(70, 242, 180, 0.20) 42%, rgba(56, 212, 255, 0.10) 72%, transparent 100%);
  animation: aurora-drift 13s ease-in-out infinite alternate;
}
.band-b {
  top: 20%;
  height: 200rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(157, 123, 255, 0.13) 40%, rgba(56, 212, 255, 0.12) 70%, transparent 100%);
  animation: aurora-drift 17s ease-in-out -5s infinite alternate-reverse;
}
.band-c {
  top: 36%;
  height: 150rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(95, 242, 192, 0.14) 50%, transparent 100%);
  animation: aurora-drift 11s ease-in-out -8s infinite alternate;
}

@keyframes aurora-drift {
  0% { transform: skewY(-7deg) translateX(-50rpx) scaleY(0.92); opacity: 0.65; }
  50% { transform: skewY(-5deg) translateX(20rpx) scaleY(1.06); opacity: 1; }
  100% { transform: skewY(-8deg) translateX(60rpx) scaleY(0.96); opacity: 0.8; }
}

/* ---------- 星空 ---------- */
.nav-star {
  position: absolute;
  border-radius: 50%;
  background: #eaf6ff;
  animation: star-twinkle 3s ease-in-out infinite;
}
.s1 { width: 5rpx; height: 5rpx; left: 7%;  top: 5%; }
.s2 { width: 7rpx; height: 7rpx; left: 22%; top: 11%; animation-delay: 0.5s; }
.s3 { width: 4rpx; height: 4rpx; left: 36%; top: 4%;  animation-delay: 1.1s; }
.s4 { width: 6rpx; height: 6rpx; left: 48%; top: 13%; animation-delay: 1.7s; }
.s5 { width: 4rpx; height: 4rpx; left: 59%; top: 6%;  animation-delay: 0.3s; }
.s6 { width: 8rpx; height: 8rpx; left: 70%; top: 10%; animation-delay: 2.1s; }
.s7 { width: 4rpx; height: 4rpx; left: 79%; top: 4%;  animation-delay: 1.4s; }
.s8 { width: 5rpx; height: 5rpx; left: 86%; top: 15%; animation-delay: 0.8s; }
.s9 { width: 6rpx; height: 6rpx; left: 93%; top: 8%;  animation-delay: 1.9s; }
.s10 { width: 4rpx; height: 4rpx; left: 14%; top: 18%; animation-delay: 2.5s; }

@keyframes star-twinkle {
  0%, 100% { opacity: 0.15; }
  50% { opacity: 0.85; }
}

/* 偶现流星（青色尾迹） */
.nav-meteor {
  position: absolute;
  left: -140rpx;
  top: 130rpx;
  width: 130rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(214, 246, 255, 0.95), rgba(56, 212, 255, 0.4), transparent);
  transform: rotate(14deg);
  opacity: 0;
  animation: meteor-fly 9s linear infinite 3s;
}

@keyframes meteor-fly {
  0%, 86% { transform: translate(0, 0) rotate(14deg); opacity: 0; }
  88% { opacity: 1; }
  100% { transform: translate(940rpx, 220rpx) rotate(14deg); opacity: 0; }
}

/* 冰月 */
.nav-moon {
  position: absolute;
  right: 76rpx;
  top: 108rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, #ffffff, #dceefc 58%, #b8d4e8);
  box-shadow:
    0 0 36rpx 10rpx rgba(214, 240, 252, 0.16),
    0 0 110rpx 40rpx rgba(180, 224, 248, 0.06);
}

/* ---------- 双层雪山 ----------
   山脊用 clip-path 锯齿轮廓；雪顶是覆盖同轮廓的白色渐变带，
   只有足够高的峰顶才会"积雪"。远山更高更亮，近山更暗。 */
.ridge {
  position: absolute;
  left: 0;
  right: 0;
}
.ridge-far {
  bottom: 686rpx;
  height: 230rpx;
  background: linear-gradient(180deg, #1d4258, #0d2438);
  clip-path: polygon(0 100%, 0 55%, 6% 34%, 12% 52%, 20% 12%, 27% 46%, 34% 26%, 42% 55%, 50% 8%, 58% 44%, 66% 22%, 74% 52%, 82% 16%, 90% 48%, 96% 30%, 100% 50%, 100% 100%);
  opacity: 0.9;
}
.ridge-far .ridge-snow {
  background: linear-gradient(180deg, rgba(214, 240, 252, 0.5) 0, rgba(214, 240, 252, 0.5) 30rpx, transparent 36rpx);
}
.ridge-near {
  bottom: 678rpx;
  height: 180rpx;
  background: linear-gradient(180deg, #123049, #081a2c);
  clip-path: polygon(0 100%, 0 62%, 8% 40%, 15% 66%, 24% 18%, 33% 58%, 40% 36%, 48% 70%, 57% 10%, 65% 52%, 72% 30%, 80% 64%, 88% 24%, 95% 56%, 100% 42%, 100% 100%);
}
.ridge-near .ridge-snow {
  background: linear-gradient(180deg, rgba(228, 247, 255, 0.78) 0, rgba(228, 247, 255, 0.78) 24rpx, transparent 30rpx);
}
.ridge-snow {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* 山间信号塔：塔身 + 两层横担 + 闪烁红色障碍灯 */
.mast {
  position: absolute;
  left: 66%;
  bottom: 678rpx;
  width: 6rpx;
  height: 190rpx;
  background: linear-gradient(180deg, #35577a, #16324a);
  border-radius: 3rpx;
}
.mast::before {
  content: ' ';
  position: absolute;
  left: -8rpx;
  top: 34rpx;
  width: 22rpx;
  height: 4rpx;
  background: #2a4a66;
  box-shadow: 0 30rpx 0 #223f58;
}
.mast-beacon {
  position: absolute;
  top: -10rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #ff4d5e;
  box-shadow: 0 0 10rpx 2rpx rgba(255, 77, 94, 0.6);
  animation: beacon-blink 1.8s ease-in-out infinite;
}

@keyframes beacon-blink {
  0%, 100% { opacity: 0.12; }
  50% { opacity: 1; }
}

/* 山脚木屋灯火：零星暖点，轻微明暗 */
.cabin-light {
  position: absolute;
  bottom: 680rpx;
  width: 7rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: #ffd9a0;
  box-shadow: 0 0 12rpx 3rpx rgba(255, 214, 138, 0.4);
  animation: cabin-flicker 5s ease-in-out infinite;
}
.cabin-light.c1 { left: 12%; }
.cabin-light.c2 { left: 31%; animation-delay: -2s; }
.cabin-light.c3 { left: 87%; animation-delay: -3.5s; }

@keyframes cabin-flicker {
  0%, 100% { opacity: 0.55; }
  45% { opacity: 1; }
  60% { opacity: 0.75; }
}

/* ---------- 伪 3D 路面 ----------
   地平线距屏幕底部 670rpx，山脚 678rpx，路消失点与山脚基本衔接。
   路面顶边在屏幕 42%~58%，底边延伸出屏（-18%~118%）。 */
.nav-ground {
  position: absolute;
  bottom: 0;
  width: 42%;
  height: 670rpx;
  background: linear-gradient(180deg, #2c4a66 0%, #1e3650 40%, #14283e 100%);
}
.nav-ground-l {
  left: 0;
  clip-path: polygon(0 0, 100% 0, 0 100%);
}
.nav-ground-r {
  right: 0;
  clip-path: polygon(100% 0, 0 0, 100% 100%);
}

.nav-road {
  position: absolute;
  left: -18%;
  right: -18%;
  bottom: 0;
  height: 670rpx;
  background: linear-gradient(180deg, #131f36 0%, #1a2740 40%, #243352 72%, #2e4066 100%);
  clip-path: polygon(42.37% 0, 57.63% 0, 100% 100%, 0 100%);
}

/* 冰面反光：近处微微泛青 */
.nav-road-sheen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(120, 210, 255, 0) 30%, rgba(120, 210, 255, 0.05) 70%, rgba(150, 230, 255, 0.10) 100%);
}

/* 路边实线：冰蓝反光标线，近亮远暗 */
.nav-edge {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(190, 235, 255, 0.10) 0%, rgba(190, 235, 255, 0.42) 45%, rgba(214, 244, 255, 0.72) 100%);
}
.nav-edge-l {
  clip-path: polygon(43.2% 0, 44.1% 0, 2.7% 100%, 0.7% 100%);
}
.nav-edge-r {
  clip-path: polygon(55.9% 0, 56.8% 0, 99.3% 100%, 97.3% 100%);
}

/* 车道虚线：冰白带青色微光，从地平线小点向下放大流动 */
.nav-dash {
  position: absolute;
  width: 14rpx;
  height: 82rpx;
  border-radius: 6rpx;
  background: rgba(230, 248, 255, 0.92);
  box-shadow: 0 0 14rpx rgba(120, 220, 255, 0.4);
  opacity: 0;
}
.nav-dash-1 {
  left: 27.33%;
  bottom: 20rpx;
  margin-left: -7rpx;
  animation: dash-1 2.4s linear infinite;
}
.nav-dash-2 {
  left: 72.67%;
  bottom: 20rpx;
  margin-left: -7rpx;
  animation: dash-2 2.4s linear infinite;
}
.nav-dash.b { animation-delay: -0.6s; }
.nav-dash.c { animation-delay: -1.2s; }
.nav-dash.d { animation-delay: -1.8s; }

/* 车道分隔线：地平线处 47.46%/52.54%，屏幕底部处 27.33%/72.67% */
@keyframes dash-1 {
  0% {
    transform: translate(151rpx, -670rpx) scale(0.1);
    opacity: 0;
  }
  10% { opacity: 0.9; }
  90% { opacity: 0.9; }
  100% {
    transform: translate(0, 0) scale(1);
    opacity: 0;
  }
}

@keyframes dash-2 {
  0% {
    transform: translate(-151rpx, -670rpx) scale(0.1);
    opacity: 0;
  }
  10% { opacity: 0.9; }
  90% { opacity: 0.9; }
  100% {
    transform: translate(0, 0) scale(1);
    opacity: 0;
  }
}

/* ---------- 路侧雪松 ----------
   三层三角形树冠，顶部积雪；按透视深度缩放 */
.nav-tree {
  position: absolute;
  width: 70rpx;
  height: 120rpx;
}
.tree-trunk {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 8rpx;
  height: 30rpx;
  margin-left: -4rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #22364a, #141f30);
}
.pine {
  position: absolute;
  left: 50%;
  clip-path: polygon(50% 0, 100% 100%, 0 100%);
}
.pine-1 {
  bottom: 78rpx;
  width: 36rpx;
  height: 34rpx;
  margin-left: -18rpx;
  background: linear-gradient(180deg, #dceef8 0, #dceef8 18%, #16384a 18%);
}
.pine-2 {
  bottom: 52rpx;
  width: 50rpx;
  height: 36rpx;
  margin-left: -25rpx;
  background: linear-gradient(180deg, #d2e8f4 0, #d2e8f4 16%, #123244 16%);
}
.pine-3 {
  bottom: 24rpx;
  width: 64rpx;
  height: 40rpx;
  margin-left: -32rpx;
  background: linear-gradient(180deg, #c8e2f0 0, #c8e2f0 14%, #0f2c3c 14%);
}
/* 左侧三棵：由近到远 */
.tree-l1 { left: 4%;   bottom: 380rpx; transform: scale(0.8); }
.tree-l2 { left: 14%;  bottom: 510rpx; transform: scale(0.5); }
.tree-l3 { left: 24%;  bottom: 570rpx; transform: scale(0.3); }
/* 右侧三棵：由近到远 */
.tree-r1 { right: 3%;  bottom: 360rpx; transform: scale(0.85); }
.tree-r2 { right: 12%; bottom: 495rpx; transform: scale(0.52); }
.tree-r3 { right: 22%; bottom: 565rpx; transform: scale(0.32); }

/* ---------- 路侧路灯 ----------
   灯杆+悬臂+暖光灯头；右侧用 scaleX(-1) 镜像；按深度缩放。
   冷夜里的大面积暖光源，与极光形成冷暖对比 */
.nav-lamp {
  position: absolute;
  width: 70rpx;
  height: 140rpx;
}
.nav-lamp::before {
  /* 灯杆 */
  content: ' ';
  position: absolute;
  left: 6rpx;
  bottom: 0;
  width: 6rpx;
  height: 128rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #3c5872, #20364e);
}
.nav-lamp::after {
  /* 悬臂 + 灯头 */
  content: ' ';
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  width: 52rpx;
  height: 22rpx;
  background:
    linear-gradient(180deg, #ffd98f, #f5b95a) no-repeat 34rpx 6rpx / 18rpx 16rpx,
    linear-gradient(180deg, #2c4258, #2c4258) no-repeat 0 0 / 40rpx 5rpx;
  border-radius: 8rpx;
  box-shadow: 0 0 16rpx 4rpx rgba(255, 214, 138, 0.4);
}
/* 灯头柔光 */
.lamp-glow {
  position: absolute;
  left: 26rpx;
  top: -14rpx;
  width: 90rpx;
  height: 54rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 214, 138, 0.3) 0%, transparent 70%);
  animation: lamp-breathe 4s ease-in-out infinite;
}

@keyframes lamp-breathe {
  0%, 100% { opacity: 0.75; }
  50% { opacity: 1; }
}

/* 左侧两盏：由近到远 */
.lamp-l1 { left: 14%;  bottom: 400rpx; transform: scale(0.72); }
.lamp-l2 { left: 26.5%; bottom: 540rpx; transform: scale(0.45); }
/* 右侧两盏：镜像 + 缩放 */
.lamp-r1 { right: 15%; bottom: 450rpx; transform: scaleX(-1) scale(0.6); }
.lamp-r2 { right: 26%; bottom: 580rpx; transform: scaleX(-1) scale(0.36); }

/* ---------- 灯下光池（暖光落在冰面上） ---------- */
.nav-pool {
  position: absolute;
  width: 140rpx;
  height: 46rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 214, 138, 0.16) 0%, rgba(255, 214, 138, 0.05) 55%, transparent 75%);
}
.pool-l1 { left: 15%;  bottom: 362rpx; transform: scale(0.8); }
.pool-l2 { left: 27.5%; bottom: 515rpx; transform: scale(0.5); }
.pool-r1 { right: 15%; bottom: 412rpx; transform: scale(0.66); }
.pool-r2 { right: 26.5%; bottom: 556rpx; transform: scale(0.4); }

/* ---------- 远方对向车灯 ----------
   消失点附近一对小亮点，缓慢呼吸 */
.nav-far-car {
  position: absolute;
  left: 51%;
  bottom: 655rpx;
  width: 24rpx;
  height: 8rpx;
  margin-left: -12rpx;
  animation: far-car-glow 6s ease-in-out infinite;
}
.far-dot {
  position: absolute;
  top: 0;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ffe9b8;
  box-shadow: 0 0 10rpx 3rpx rgba(255, 230, 180, 0.55);
}
.far-dot-l { left: 0; }
.far-dot-r { right: 0; }

@keyframes far-car-glow {
  0%, 100% { opacity: 0.2; transform: scale(0.7); }
  50% { opacity: 1; transform: scale(1); }
}

/* ---------- 行驶中的小车 ----------
   几何：路面梯形底边在屏幕底（宽 136%）、顶边在 670rpx（宽 16%），
   车底在 240rpx。透视原理：车开向远方时，屏幕位移先快后慢、
   缩放与路面宽度同比例收缩（宽度比 = 该处路宽 / 240rpx 处路宽）。
   以 transform-origin: 50% 100%（车轮接地点）为缩放锚点，
   车身始终"坐"在路面上。
   translateY 必须写在 scale 之前，否则位移会被缩放系数吞噬。 */
.nav-car {
  position: absolute;
  left: 50%;
  bottom: 240rpx;
  width: 74rpx;
  height: 118rpx;
  margin-left: -37rpx;
  transform-origin: 50% 100%;
  animation: car-sway 4.5s ease-in-out infinite;
  /* 松手后未切歌时平滑退回原位 */
  transition: transform 0.45s cubic-bezier(0.22, 1.2, 0.36, 1), opacity 0.3s ease;
}

@keyframes car-sway {
  0%, 100% { transform: scaleY(0.86) translateX(0); }
  25% { transform: scaleY(0.86) translateX(5rpx); }
  50% { transform: scaleY(0.86) translateX(0); }
  75% { transform: scaleY(0.86) translateX(-5rpx); }
}

/* 切歌成功：小车沿路面驶向雪山脚下（655rpx 处）
   0% 对齐拖拽阈值时的小车位置，松手瞬间无跳变；
   各关键帧的位移/缩放按路面宽度曲线标定：
   h=360→0.77  h=478→0.54  h=552→0.40  h=611→0.29  h=655→0.20 */
.nav-car.leaving {
  animation: car-leave 1.15s linear forwards;
}

@keyframes car-leave {
  0%   { transform: translateY(-120rpx) scaleY(0.86) scale(0.77); opacity: 1; }
  20%  { transform: translateY(-238rpx) scaleY(0.86) scale(0.54); opacity: 1; }
  45%  { transform: translateY(-312rpx) scaleY(0.86) scale(0.4); opacity: 1; }
  70%  { transform: translateY(-371rpx) scaleY(0.86) scale(0.29); opacity: 0.85; }
  100% { transform: translateY(-415rpx) scaleY(0.86) scale(0.2); opacity: 0; }
}

/* 新车从屏幕底部（近处）驶入到原位：由大变小、由快到慢
   缩放同样跟随路宽比：h=-190→1.83  h=-10→1.48  h=130→1.21 */
.nav-car.entering {
  animation: car-enter 1s linear forwards;
}

@keyframes car-enter {
  0%   { transform: translateY(430rpx) scaleY(0.86) scale(1.8); opacity: 0; }
  18%  { opacity: 1; }
  35%  { transform: translateY(250rpx) scaleY(0.86) scale(1.48); opacity: 1; }
  65%  { transform: translateY(110rpx) scaleY(0.86) scale(1.21); opacity: 1; }
  100% { transform: translateY(0) scaleY(0.86) scale(1); opacity: 1; }
}

/* 车轮接地点阴影 */
.nav-car-shadow {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  width: 128rpx;
  height: 30rpx;
  margin-left: -64rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55) 0%, transparent 68%);
}

/* 车头灯光锥（向前上方投射，近车窄远端宽） */
.nav-car-lightcone {
  position: absolute;
  top: -86rpx;
  width: 66rpx;
  height: 96rpx;
  background: linear-gradient(180deg, rgba(255, 216, 148, 0) 0%, rgba(255, 216, 148, 0.16) 100%);
  clip-path: polygon(0 0, 100% 0, 72% 100%, 28% 100%);
}
.nav-car-lightcone-l { left: 2rpx; }
.nav-car-lightcone-r { right: 2rpx; }

/* 车身：珊瑚橘，冷夜中的暖色焦点 */
.nav-car-body {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #ff9a5c 0%, #f0703c 60%, #d8552a 100%);
  border-radius: 18rpx 18rpx 14rpx 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.45);
}

/* 引擎盖（顶部高光） */
.nav-car-hood {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #ffc490, #ff9a5c);
  border-radius: 12rpx;
}

/* 前挡风玻璃（映着冰月） */
.nav-car-windshield {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 36rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #e8f6ff, #a8d0ec);
  border-radius: 8rpx;
}

/* 车顶：一道极光反射 */
.nav-car-roof {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 64rpx;
  bottom: 42rpx;
  background: linear-gradient(180deg, #ff8a4c, #ef6a3a);
  border-radius: 10rpx;
  overflow: hidden;
}
.nav-car-roof::after {
  content: ' ';
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 4rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(120, 240, 200, 0.4), transparent);
}

/* 后挡风玻璃 */
.nav-car-rearwindow {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 24rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #bcdcf2, #8cb8dc);
  border-radius: 8rpx;
}

/* 后视镜 */
.nav-car-mirror {
  position: absolute;
  top: 40rpx;
  width: 12rpx;
  height: 18rpx;
  background: #d8552a;
  border-radius: 4rpx;
}
.nav-car-mirror-l { left: -10rpx; }
.nav-car-mirror-r { right: -10rpx; }

/* 车头灯（暖光） */
.nav-car-headlight {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 2rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #ffe9b0;
  box-shadow: 0 0 16rpx 5rpx rgba(255, 224, 150, 0.55);
}

/* 尾灯（红光） */
.nav-car-taillight {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 2rpx;
  height: 7rpx;
  border-radius: 4rpx;
  background: #ff4d5e;
  box-shadow: 0 0 12rpx 3rpx rgba(255, 77, 94, 0.5);
}

/* ---------- 飘雪 ----------
   少量慢速雪花增加空气感；只动 transform/opacity */
.snowflake {
  position: absolute;
  top: -30rpx;
  border-radius: 50%;
  background: rgba(234, 246, 255, 0.85);
  opacity: 0;
}
.snowflake.f1 { left: 6%;  width: 6rpx; height: 6rpx; animation: snow-fall-a 11s linear -2s infinite; }
.snowflake.f2 { left: 18%; width: 8rpx; height: 8rpx; animation: snow-fall-b 14s linear -7s infinite; }
.snowflake.f3 { left: 33%; width: 5rpx; height: 5rpx; animation: snow-fall-a 12s linear -4s infinite; }
.snowflake.f4 { left: 47%; width: 7rpx; height: 7rpx; animation: snow-fall-b 15s linear -10s infinite; }
.snowflake.f5 { left: 62%; width: 5rpx; height: 5rpx; animation: snow-fall-a 13s linear -1s infinite; }
.snowflake.f6 { left: 76%; width: 8rpx; height: 8rpx; animation: snow-fall-b 11s linear -6s infinite; }
.snowflake.f7 { left: 90%; width: 6rpx; height: 6rpx; animation: snow-fall-a 14s linear -9s infinite; }

@keyframes snow-fall-a {
  0% { transform: translate(0, -40rpx); opacity: 0; }
  8% { opacity: 0.7; }
  90% { opacity: 0.5; }
  100% { transform: translate(40rpx, 115vh); opacity: 0; }
}

@keyframes snow-fall-b {
  0% { transform: translate(0, -40rpx); opacity: 0; }
  8% { opacity: 0.6; }
  90% { opacity: 0.45; }
  100% { transform: translate(-46rpx, 115vh); opacity: 0; }
}

/* 暗角：聚焦画面中心 */
.nav-vignette {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(125% 92% at 50% 44%, transparent 55%, rgba(2, 8, 16, 0.55) 100%);
}

/* ---------- HUD 玻璃卡片头部 + 歌词 ---------- */
.car-mode-player {
  position: fixed;
  left: 36rpx;
  top: 80rpx;
  right: 36rpx;
  bottom: 540rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: white;
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(26rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- HUD 状态行：巡航徽章 + 航线坐标 ---------- */
.hud-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  animation: rise-in 0.7s cubic-bezier(0.22, 0.9, 0.3, 1) both;
}
.hud-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(8, 22, 38, 0.5);
  border: 1rpx solid rgba(70, 242, 180, 0.28);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #bfe9d8;
}
.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #46f2b4;
  box-shadow: 0 0 10rpx rgba(70, 242, 180, 0.7);
  margin-right: 12rpx;
  animation: dot-pulse 2.2s ease-in-out infinite;
}
.hud-coord {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7fa8c0;
}

/* 玻璃卡片：歌曲信息 / 时钟仪表条 / 操作提示，三段结构 */
.car-mode-header {
  position: relative;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, rgba(12, 28, 46, 0.6), rgba(6, 16, 30, 0.5));
  border: 1rpx solid rgba(140, 220, 255, 0.14);
  border-radius: 36rpx;
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.45);
  animation: rise-in 0.7s cubic-bezier(0.22, 0.9, 0.3, 1) both 0.1s;
  overflow: hidden;
}

/* 卡片顶部极光高光条 */
.car-mode-header::before {
  content: ' ';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(56, 212, 255, 0.5), rgba(70, 242, 180, 0.5), transparent);
}

.car-mode-header-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 26rpx 16rpx;
}

.car-mode-img image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(140, 220, 255, 0.2);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.45), 0 0 24rpx rgba(70, 242, 180, 0.12);
}

/* ---------- 收藏按钮（双态药丸） ----------
   未收藏 = 冰蓝描边空心 + 「收藏」；已收藏 = 珊瑚实心爱心 + 「已收藏」。
   空心爱心：外层 clip-path 心形铺描边色，内层同形状内缩 3rpx 挖空；
   查询/请求中显示旋转 spinner；收藏成功光环 + 粒子爆点一次。 */
.fav-btn {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  align-self: flex-start;
  height: 52rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(9, 22, 38, 0.55);
  border: 1rpx solid rgba(140, 220, 255, 0.3);
  transition: background 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
}
.fav-btn-hover {
  background: rgba(20, 40, 62, 0.72);
  border-color: rgba(140, 220, 255, 0.55);
}
.fav-btn.faved {
  background: rgba(232, 58, 86, 0.16);
  border-color: rgba(255, 107, 129, 0.55);
}
.fav-btn.faved.fav-btn-hover {
  background: rgba(232, 58, 86, 0.3);
  border-color: rgba(255, 143, 163, 0.8);
}
.fav-btn.need-login {
  opacity: 0.6;
}
.fav-btn.busy {
  opacity: 0.85;
}

.fav-btn-icon {
  position: relative;
  width: 30rpx;
  height: 28rpx;
  margin-right: 12rpx;
}
/* 心形轮廓：顶部双峰 + 中央凹口 + 底部尖角 */
.fav-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 30rpx;
  height: 28rpx;
  clip-path: polygon(50% 96%, 6% 46%, 0 26%, 8% 7%, 27% 0, 42% 8%, 50% 22%, 58% 8%, 73% 0, 92% 7%, 100% 26%, 94% 46%);
  background: #8fb4cc;
  transition: background 0.25s ease;
}
.fav-icon-inner {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 3rpx;
  bottom: 3rpx;
  clip-path: polygon(50% 96%, 6% 46%, 0 26%, 8% 7%, 27% 0, 42% 8%, 50% 22%, 58% 8%, 73% 0, 92% 7%, 100% 26%, 94% 46%);
  background: #0a192a;
  transition: background 0.25s ease;
}
.fav-btn.faved .fav-icon {
  background: #ff5c76;
  filter: drop-shadow(0 0 8rpx rgba(255, 92, 118, 0.55));
}
.fav-btn.faved .fav-icon-inner {
  background: #ff5c76;
}

/* 查询/请求中的旋转指示 */
.fav-spinner {
  position: absolute;
  left: 3rpx;
  top: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(140, 220, 255, 0.25);
  border-top-color: #5ff2c0;
  animation: fav-spin 0.8s linear infinite;
}

@keyframes fav-spin {
  to { transform: rotate(360deg); }
}

.fav-btn-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #9fc3d8;
  transition: color 0.25s ease;
}
.fav-btn.faved .fav-btn-label {
  color: #ffb3c0;
}
.fav-btn.busy .fav-btn-label {
  color: #7fa8c0;
}

/* 收藏成功：按钮轻弹 + 爱心放大回弹 */
.fav-btn.burst {
  animation: fav-btn-pop 0.6s cubic-bezier(0.22, 1.4, 0.36, 1);
}
.fav-btn.burst .fav-icon {
  animation: fav-icon-pop 0.6s cubic-bezier(0.22, 1.6, 0.36, 1);
}

@keyframes fav-btn-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes fav-icon-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.45); }
  60% { transform: scale(0.92); }
  100% { transform: scale(1); }
}

/* 扩散光环 */
.fav-btn-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  margin: -15rpx 0 0 -15rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 107, 129, 0.85);
  opacity: 0;
}
.fav-btn.burst .fav-btn-ring {
  animation: fav-ring 0.65s ease-out both;
}

@keyframes fav-ring {
  0% { transform: scale(0.5); opacity: 0.9; }
  100% { transform: scale(2.6); opacity: 0; }
}

/* 飞散粒子：珊瑚 / 琥珀 / 冰白 */
.fav-btn-particle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: #ff8fa3;
  opacity: 0;
}
.fav-btn-particle.p2 { background: #ffc46b; width: 6rpx; height: 6rpx; }
.fav-btn-particle.p3 { background: #dceefc; }
.fav-btn-particle.p4 { background: #ff5c76; width: 6rpx; height: 6rpx; }
.fav-btn.burst .fav-btn-particle {
  animation: fav-particle-fly 0.65s cubic-bezier(0.16, 0.8, 0.35, 1) both;
}
.fav-btn.burst .p1 { --px: 0; --py: -44rpx; }
.fav-btn.burst .p2 { --px: 40rpx; --py: -20rpx; animation-delay: 0.03s; }
.fav-btn.burst .p3 { --px: -40rpx; --py: -24rpx; animation-delay: 0.05s; }
.fav-btn.burst .p4 { --px: 24rpx; --py: 34rpx; animation-delay: 0.02s; }

@keyframes fav-particle-fly {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  60% { opacity: 0.9; }
  100% { transform: translate(var(--px), var(--py)) scale(0.4); opacity: 0; }
}

.car-mode-song {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 0 24rpx;
  overflow: hidden;
}

.car-mode-name {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #f2f9ff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.car-mode-singer {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #8fb4cc;
  margin-top: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 时钟仪表条：冰白时间居左、分隔线、日期+星期居右 */
.car-mode-clock {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 26rpx;
  border-top: 1rpx solid rgba(140, 220, 255, 0.1);
  background: rgba(4, 12, 22, 0.25);
}
.clock-time {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #eaf6ff;
  text-shadow: 0 0 18rpx rgba(56, 212, 255, 0.35);
  font-variant-numeric: tabular-nums;
}
.clock-divider {
  width: 1rpx;
  height: 40rpx;
  margin: 0 22rpx;
  background: rgba(140, 220, 255, 0.25);
}
.clock-date-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: auto;
}
.clock-date {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #9fc3d8;
  font-variant-numeric: tabular-nums;
}
.clock-week {
  margin-top: 4rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #5ff2c0;
}

/* 卡片内嵌操作提示行 */
.car-mode-tips-inline {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 12rpx 26rpx 16rpx;
}
.tips-inline-text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #7fa8c0;
}

/* 播放中的均衡器动效：极光渐变音条 */
.car-mode-eq {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 48rpx;
}
.eq-bar {
  width: 7rpx;
  margin-left: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #5ff2c0, #38d4ff);
  box-shadow: 0 0 12rpx rgba(70, 242, 180, 0.45);
  transform-origin: 50% 100%;
  animation: eq-bounce 0.9s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
}
.eq-bar-1 { height: 20rpx; animation-delay: -0.1s; }
.eq-bar-2 { height: 40rpx; animation-delay: -0.5s; }
.eq-bar-3 { height: 28rpx; animation-delay: -0.3s; }
.eq-bar-4 { height: 44rpx; animation-delay: -0.7s; }
.eq-bar-5 { height: 24rpx; animation-delay: -0.2s; }

@keyframes eq-bounce {
  from { transform: scaleY(0.3); opacity: 0.75; }
  to { transform: scaleY(1); opacity: 1; }
}

/* ---------- 多行歌词（固定视窗 + 整体平移居中） ---------- */
.car-lrc-window {
  flex: 1;
  min-height: 0;
  margin-top: 22rpx;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 90rpx, #000 calc(100% - 90rpx), transparent 100%);
  animation: rise-in 0.7s cubic-bezier(0.22, 0.9, 0.3, 1) both 0.28s;
}

.car-lrc-list {
  transition: transform 0.5s cubic-bezier(0.22, 0.9, 0.3, 1);
  will-change: transform;
}

.lrc-placeholder {
  padding: 40rpx 30rpx;
  font-size: 30rpx;
  line-height: 1.7;
  letter-spacing: 2rpx;
  text-align: center;
  color: rgba(234, 246, 255, 0.45);
}

/* 行高固定，保证平移计算的稳定性 */
.lrc-line {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  font-size: 33rpx;
  letter-spacing: 2rpx;
  text-align: center;
  color: rgba(234, 246, 255, 0.32);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: color 0.35s ease, font-size 0.35s ease, text-shadow 0.35s ease;
}

/* 当前行：极光绿 + 微光（与天际极光呼应） */
.lrc-line.active {
  color: #7df5c8;
  font-size: 44rpx;
  font-weight: 600;
  text-shadow: 0 0 28rpx rgba(70, 242, 180, 0.35), 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

/* 当前行前后各一行：临近高亮，过渡更自然 */
.lrc-line.near {
  color: rgba(234, 246, 255, 0.66);
}

/* ---------- 底部按钮与提示 ---------- */
.car-back {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  animation: rise-in 0.6s cubic-bezier(0.22, 0.9, 0.3, 1) both 0.42s;
}

.car-back button {
  background: linear-gradient(135deg, rgba(38, 14, 24, 0.78), rgba(18, 9, 16, 0.7));
  border: 1rpx solid rgba(255, 107, 129, 0.5);
  color: #ff9fae;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  line-height: 1;
  padding: 30rpx 0;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 14rpx 36rpx rgba(255, 77, 109, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.car-back button:active {
  background: linear-gradient(135deg, rgba(56, 18, 32, 0.85), rgba(28, 12, 22, 0.78));
  border-color: rgba(255, 143, 163, 0.8);
  color: #ffc2cc;
  transform: scale(0.97);
}

.car-back button::after {
  border: none;
}

/* 提示圆点（卡片内嵌提示行使用） */
.tips-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(70, 242, 180, 0.9);
  box-shadow: 0 0 10rpx rgba(70, 242, 180, 0.6);
  margin-right: 14rpx;
  animation: dot-pulse 2.2s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

/* ---------- 上滑切歌指示器 ----------
   滑动进度条 + 文案；到达阈值时整体点亮并放大 */
.swipe-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 260rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(16rpx) scale(0.9);
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
  z-index: 40;
}
.swipe-hint.show {
  opacity: 1;
  transform: translateY(0) scale(1);
}
.swipe-hint.ready {
  transform: translateY(0) scale(1.06);
}

.swipe-hint-track {
  width: 220rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(140, 220, 255, 0.14);
  overflow: hidden;
}
.swipe-hint-thumb {
  height: 100%;
  width: 0;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(56, 212, 255, 0.7), #5ff2c0);
  box-shadow: 0 0 12rpx rgba(70, 242, 180, 0.5);
  transition: width 0.12s linear;
}
.swipe-hint.ready .swipe-hint-thumb {
  width: 100%;
}

.swipe-hint-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(234, 246, 255, 0.55);
  transition: color 0.2s ease, text-shadow 0.2s ease;
}
.swipe-hint.ready .swipe-hint-label {
  color: #7df5c8;
  font-weight: 600;
  text-shadow: 0 0 16rpx rgba(70, 242, 180, 0.5);
}

/* ---------- 切歌确认卡片 ----------
   “换挡”式提示：极光掠过 + 缩放浮现 */
.pass-toast {
  position: fixed;
  left: 50%;
  top: 42%;
  width: 300rpx;
  padding: 44rpx 0 40rpx;
  margin-left: -150rpx;
  text-align: center;
  background: rgba(6, 18, 30, 0.6);
  border: 1rpx solid rgba(70, 242, 180, 0.4);
  border-radius: 32rpx;
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.5);
  opacity: 0;
  transform: translateX(-0%) translateY(24rpx) scale(0.82);
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1.4, 0.36, 1);
  pointer-events: none;
  z-index: 50;
}
.pass-toast.show {
  opacity: 1;
  transform: translateX(0) translateY(0) scale(1);
}

.pass-toast-text {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
  text-indent: 16rpx;
  color: #ffffff;
  text-shadow: 0 0 24rpx rgba(70, 242, 180, 0.45);
}

.pass-toast-sub {
  margin-top: 10rpx;
  font-size: 19rpx;
  letter-spacing: 6rpx;
  color: rgba(95, 242, 192, 0.85);
}

/* 卡片内掠过的光带 */
.pass-toast-glow {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  background: linear-gradient(105deg, transparent, rgba(120, 255, 210, 0.16), transparent);
  transform: translateX(-100%);
}
.pass-toast.show .pass-toast-glow {
  animation: glow-sweep 0.7s ease-out 0.1s;
}

@keyframes glow-sweep {
  from { transform: translateX(-100%); }
  to { transform: translateX(350%); }
}
