<view wx:if="{{bbbug}}">
  <view wx:if="{{songList.length==0}}">
    <view class="tipImage">
      <image class="img" src="/res/image/alert.png" />
    </view>
    <view class="tipText">没有歌曲啦，快去点歌吧</view>
  </view>
  <view class="weui-panel weui-panel_access songList" wx:if="{{songList.length>0}}">
    <view class="weui-panel__bd">
      <view class="weui-media-box weui-media-box_appmsg" wx:for="{{songList}}" wx:key="_id" bindtap="showMenu" mark:item="{{item}}">
        <view class="weui-media-box__hd">
          <image class="weui-media-box__thumb song_image" src="{{item.song.pic || '/res/image/nohead.jpg'}}" alt="" mode="widthFix" binderror="onSongPicError" data-index="{{index}}"></image>
        </view>
        <view class="weui-media-box__bd">
          <view class="weui-media-box__title">{{item.song.name}}</view>
          <view class="weui-media-box__desc">点歌人：{{item.user.user_name}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
